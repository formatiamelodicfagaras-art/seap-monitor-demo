# ─── Database ─────────────────────────────────────────────────────────
# SQLite for local dev (default). For production, point at PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/seap_monitor
DATABASE_URL=sqlite+aiosqlite:///./seap_monitor.db

# ─── Redis (Celery broker) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ─────────────────────────────────────────────────────────────
# Change these before any non-local deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SESSION_SECRET=generate_a_long_random_string_here

# ─── Email — Microsoft 365 (Graph API OAuth2) ─────────────────────────
# Required only if you want CPV-match notification emails.
# Register an app at https://portal.azure.com → App registrations,
# grant Mail.Send application permission, then paste the values below.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=noreply@example.com

# ─── Anthropic API (Claude) ───────────────────────────────────────────
# Required only for the AI analysis and bid-generation modules.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:8050
SCAN_INTERVAL_HOURS=6
STORAGE_PATH=./storage

# ─── Docker compose: Postgres bootstrap ───────────────────────────────
# Only used when running via docker-compose with the bundled Postgres.
DB_NAME=seap_monitor
DB_USER=seap_user
DB_PASSWORD=change_me_strong_password
